# [PÉDAGOGIE] ============================================================================
# [PÉDAGOGIE] FICHIER — .env.example
# [PÉDAGOGIE] MODULE  — M23–M26 — configuration externe et principes 12-factor
# [PÉDAGOGIE] RÔLE    — Documenter les noms de variables attendues sans versionner de valeur
# [PÉDAGOGIE]           secrète réelle.
# [PÉDAGOGIE] THÉORIE — le code reste identique entre environnements ; seules les valeurs changent
# [PÉDAGOGIE]           • un exemple décrit un contrat de configuration, pas des identifiants
# [PÉDAGOGIE]             réels
# [PÉDAGOGIE]           • la validation à la frontière doit échouer clairement si une valeur
# [PÉDAGOGIE]             obligatoire manque
# [PÉDAGOGIE] À VOIR  — La copie locale .env est lue au runtime et doit rester hors de Git.
# [PÉDAGOGIE] PIÈGE   — Ne jamais remplacer une valeur d'exemple par une clé, un mot de passe ou
# [PÉDAGOGIE]           un jeton réel.
# [PÉDAGOGIE] GARDE   — Toutes les lignes marquées [PÉDAGOGIE] sont des commentaires : elles
# [PÉDAGOGIE]           guident la lecture sans changer l'exécution.
# [PÉDAGOGIE] ============================================================================

# =============================================================================
# .env.example — MODELE de fichier de variables d'environnement
# -----------------------------------------------------------------------------
# ROLE : montre quelles variables le projet attend, SANS contenir de vraie
# valeur sensible. On le COPIE en ".env" (qui, lui, est ignore par Git) et on
# y met ses propres valeurs. Ces variables sont lues au demarrage par
# pydantic-settings pour configurer le projet (chemins, parametres...).
#
# Mode d'emploi : copier ce fichier en ".env" puis adapter les valeurs.
# IMPORTANT (syntaxe .env) : on commente UNIQUEMENT avec # AU-DESSUS de chaque
# ligne CLE=valeur. On ne met JAMAIS de commentaire en fin de ligne apres la
# valeur, car certaines librairies l'incluraient dans la valeur lue.
# =============================================================================

# Dossier contenant les donnees brutes (raw) en entree.
# [PÉDAGOGIE] VARIABLE `INDUSENSE_DATA_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_DATA_DIR=data/raw
# Dossier des donnees "gold" (donnees nettoyees/preparees, pretes a l'emploi).
# [PÉDAGOGIE] VARIABLE `INDUSENSE_GOLD_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_GOLD_DIR=data/gold
# Dossier ou sont stockes les modeles entraines (fichiers .joblib, metadonnees).
# [PÉDAGOGIE] VARIABLE `INDUSENSE_MODEL_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_MODEL_DIR=artifacts/models
# Graine aleatoire fixe : garantit des resultats reproductibles d'une execution a l'autre.
# [PÉDAGOGIE] VARIABLE `INDUSENSE_RANDOM_SEED` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_RANDOM_SEED=42
# Nom de la colonne CIBLE a predire (ici "panne" : 1 = panne, 0 = pas de panne).
# [PÉDAGOGIE] VARIABLE `INDUSENSE_TARGET_COL` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_TARGET_COL=panne
# Fenetre temporelle (en heures) pour rattacher un incident a une panne.
# [PÉDAGOGIE] VARIABLE `INDUSENSE_INCIDENT_WINDOW_HOURS` — nom du réglage attendu ; conserver ici
# [PÉDAGOGIE] une valeur factice non sensible.
INDUSENSE_INCIDENT_WINDOW_HOURS=24

# --- API & Docker Compose (J2/J3) ---
# Cle d'API exigee par l'API dans l'en-tete X-API-Key. En developpement : dev-key.
# [PÉDAGOGIE] VARIABLE `INDUSENSE_API_KEY` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_API_KEY=dev-key
# Seuil de decision : proba de panne >= seuil -> "alerte", sinon "ok".
# [PÉDAGOGIE] VARIABLE `INDUSENSE_DECISION_THRESHOLD` — nom du réglage attendu ; conserver ici une
# [PÉDAGOGIE] valeur factice non sensible.
INDUSENSE_DECISION_THRESHOLD=0.5
# Mot de passe PostgreSQL utilise par docker compose (DEV UNIQUEMENT : a changer ailleurs).
# [PÉDAGOGIE] VARIABLE `POSTGRES_PASSWORD` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
POSTGRES_PASSWORD=indusense
