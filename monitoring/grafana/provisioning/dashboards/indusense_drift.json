{
  "uid": "indusense-drift",
  "title": "InduSense — dérive & métriques (TP m31)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "bargauge", "title": "PSI par capteur (vs référence choisie)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "indusense_drift_psi", "legendFormat": "{{feature}} · f{{fenetre}} vs {{reference}}", "refId": "A" } ],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.10 }, { "color": "red", "value": 0.25 } ] } }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Rappel panne (seuil gelé)",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "indusense_drift_rappel", "legendFormat": "fenêtre {{fenetre}}", "refId": "A" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.6 }, { "color": "green", "value": 0.75 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Taux d'alerte (charge maintenance)",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "indusense_drift_taux_alerte", "legendFormat": "fenêtre {{fenetre}}", "refId": "A" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 0.6 } ] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "timeseries", "title": "PSI dans le temps (relancez evaluate_drift pour alimenter)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [ { "expr": "indusense_drift_psi", "legendFormat": "{{feature}} · f{{fenetre}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "Précision des alertes (KPI de confirmation précoce)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
      "targets": [ { "expr": "indusense_drift_precision", "legendFormat": "fenêtre {{fenetre}}", "refId": "A" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "min": 0, "max": 0.3, "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "green", "value": 0.09 } ] } }, "overrides": [] }
    },
    {
      "id": 6, "type": "stat", "title": "ROC-AUC (classement — < 0,5 = inversé !)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
      "targets": [ { "expr": "indusense_drift_roc_auc", "legendFormat": "fenêtre {{fenetre}}", "refId": "A" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.7 } ] } }, "overrides": [] }
    }
  ]
}
